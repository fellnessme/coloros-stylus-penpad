<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aclaniakea.penpad"
    android:versionCode="3"
    android:versionName="1.2">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="xyz.shizuku.extra.permission.API_V23" />
    <uses-permission android:name="moe.shizuku.privileged.api.permission.API_V23" />

    <!-- Android 11+ 包可见性：不加这个就找不到 Shizuku 的 provider -->
    <queries>
        <package android:name="xyz.shizuku.extra.api" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_pen"
        android:allowBackup="false"
        android:directBootAware="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <!-- 隐藏桌面图标：不声明 LAUNCHER，改由通知栏磁贴启动 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <service
            android:name=".PenTileService"
            android:exported="true"
            android:icon="@drawable/ic_pen"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".PenKeyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aclaniakea.penpad.PENKEY" />
            </intent-filter>
        </receiver>

        <service
            android:name=".FloatService"
            android:exported="false" />

        <service
            android:name=".PenKeyService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pen_accessibility" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false" />

    </application>
</manifest>
